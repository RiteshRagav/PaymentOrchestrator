# ==========================================
# Payment Orchestration Router Environment Config
# ==========================================

# Database Configuration
POSTGRES_DB=payment_orchestrator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5432

# Backend Service
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Gateway Mock Tuning
GATEWAY_A_FAILURE_RATE=0.20
GATEWAY_A_LATENCY_MS=500
GATEWAY_B_FAILURE_RATE=0.50
GATEWAY_B_LATENCY_MS=800
GATEWAY_C_FAILURE_RATE=0.05
GATEWAY_C_LATENCY_MS=300

# Frontend Service
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api
